rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '일반인');
    }

    function isJjang() {
      return isLoggedIn() && getRole() == '짱';
    }

    function canWrite() {
      return isLoggedIn() && (getRole() == '짱' || getRole() == '일진');
    }

    // 프로필: 로그인 사용자 읽기/등록, 짱/일진만 수정/삭제
    match /profiles/{profileId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if canWrite();
    }

    // 매칭
    match /matchings/{matchingId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if canWrite();
    }

    // 사용자: 로그인 사용자는 본인 문서 읽기/쓰기 가능 (role 변경은 짱만)
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && (
        request.auth.uid == userId ||
        isJjang()
      );
      allow delete: if isJjang();
    }
  }
}
