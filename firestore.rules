rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isJjang() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == '짱';
    }

    function isIljin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == '일진';
    }

    function canWrite() {
      return isJjang() || isIljin();
    }

    // 프로필: 로그인 사용자 읽기, 모든 로그인 사용자 등록, 짱/일진만 수정/삭제
    match /profiles/{profileId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if canWrite();
    }

    // 매칭: 로그인 읽기, 짱/일진 쓰기
    match /matchings/{matchingId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if canWrite();
    }

    // 사용자: 본인 읽기/쓰기(role 제외), 짱 전체
    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isJjang());
      allow create: if request.auth.uid == userId;
      allow update: if isJjang() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isJjang();
    }
  }
}
