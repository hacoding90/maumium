rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isJuseonja() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role in ['주선자1', '주선자2', '주선자3', '주선자4', '주선자5'];
    }

    function isAdminOrJuseonja() {
      return isAdmin() || isJuseonja();
    }

    // 프로필: 로그인 사용자 읽기, 관리자/주선자 쓰기
    match /profiles/{profileId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdminOrJuseonja();
    }

    // 매칭: 로그인 사용자 읽기, 관리자/주선자 쓰기
    match /matchings/{matchingId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdminOrJuseonja();
    }

    // 사용자: 본인 읽기/쓰기(role 제외), 관리자 전체 권한
    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth.uid == userId;
      allow update: if isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }
  }
}
